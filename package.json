{
  "name": "chameleon-protocol",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "start:prod": "NODE_ENV=production npm run start --workspace=backend",
    "build:prod": "npm run build && echo 'Frontend built, ready for production'"
  }
}
