        "errorMessage": "Guardian information is required for patients under 18 years old"
      },
      {
        "id": "insurance-required-fields",
        "rule": "if has-insurance = yes, require insurance-provider and insurance-number",
        "condition": {
          "field": "has-insurance",
          "equals": "yes"
        },
        "action": {
          "type": "require-fields",
          "targetFields": ["insurance-provider", "insurance-number"]
